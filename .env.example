# ============ Copia este archivo como ".env" y completa los valores ============
# (".env" NUNCA se sube a GitHub; ya esta en .gitignore)

# --- PostgreSQL (usuario fijo: olist) ---
PG_DB=olist_pg
PG_PASSWORD=olist_pg_2026

# --- MySQL (usuario fijo: olist) ---
MYSQL_PASSWORD=olist_my_2026
MYSQL_ROOT_PASSWORD=root_my_2026

# --- Airflow (login de la interfaz web) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=cambia-esta-frase-por-algo-largo-y-aleatorio

# --- Snowflake ---
# Formato nuevo: ORGANIZACION-CUENTA  (Snowsight > tu nombre abajo-izq > Account > "Copy account identifier")
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Opcional (si tu cuenta exige MFA para password): ruta de llave RSA dentro del contenedor
# SNOWFLAKE_PRIVATE_KEY_FILE=/opt/airflow/secrets/rsa_key.p8
